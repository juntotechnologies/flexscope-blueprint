    {
      "name": "phone-quality-full-run",
      "path": "quality/",
      "pageReady": "#quiz[data-screen=intro]",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-go=rater]"
        },
        {
          "click": "#rater-form input[name=role][value=\"ENT attending\"] + span"
        },
        {
          "click": "#rater-form input[name=setting][value=\"Low-resource hospital\"] + span"
        },
        {
          "click": "#rater-form input[name=scopes][value=\"6-20\"] + span"
        },
        {
          "click": "#rater-next"
        },
        {
          "ready": "#quiz[data-screen=trial]"
        },
        {
          "wait": 1500
        },
        {
          "click": "#trial-form input[name=lesion][value=\"No\"] + span"
        },
        {
          "click": "#trial-form input[name=mobility][value=\"Both move\"] + span"
        },
        {
          "click": "#trial-form input[name=usable][value=\"4\"] + span"
        },
        {
          "click": "#trial-next"
        },
        {
          "wait": 300
        },
        {
          "click": "#trial-form input[name=lesion][value=\"No\"] + span"
        },
        {
          "click": "#trial-form input[name=mobility][value=\"Both move\"] + span"
        },
        {
          "click": "#trial-form input[name=usable][value=\"4\"] + span"
        },
        {
          "click": "#trial-next"
        },
        {
          "wait": 300
        },
        {
          "click": "#trial-form input[name=lesion][value=\"No\"] + span"
        },
        {
          "click": "#trial-form input[name=mobility][value=\"Both move\"] + span"
        },
        {
          "click": "#trial-form input[name=usable][value=\"4\"] + span"
        },
        {
          "click": "#trial-next"
        },
        {
          "wait": 300
        },
        {
          "click": "#trial-form input[name=lesion][value=\"No\"] + span"
        },
        {
          "click": "#trial-form input[name=mobility][value=\"Both move\"] + span"
        },
        {
          "click": "#trial-form input[name=usable][value=\"4\"] + span"
        },
        {
          "click": "#trial-next"
        },
        {
          "wait": 300
        }
      ],
      "expect": "#quiz[data-screen=done]",
      "expectJs": "(() => { const s = JSON.parse(globalThis.qualityLastSubmission); const levels = new Set(s.trials.map(t => t.level)); return s.trials.length === 4 && levels.size === 4 && s.rater.setting === 'Low-resource hospital' && s.trials.every(t => t.answers.usable === '4'); })()"
    },
    {
      "name": "phone-quality-trial",
