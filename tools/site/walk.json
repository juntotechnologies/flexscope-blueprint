{
  "ready": "#viewport[aria-busy=\"false\"]",
  "steps": [
    {
      "name": "laptop-assembled",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "wait": 2500
        },
        {
          "click": "[data-view=assembled]"
        },
        {
          "wait": 1500
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        }
      ],
      "expect": "#spacing[value=\"0\"], #drawing:not([data-playing]) svg[aria-label$=\"assembled view\"]"
    },
    {
      "name": "laptop-animating",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "wait": 500
        },
        {
          "click": "[data-view=assembled]"
        },
        {
          "wait": 250
        }
      ],
      "expect": "#drawing[data-playing]"
    },
    {
      "name": "laptop-slider-drag",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "fill": [
            "#spacing",
            "60"
          ]
        },
        {
          "wait": 30
        },
        {
          "fill": [
            "#spacing",
            "40"
          ]
        },
        {
          "wait": 30
        }
      ],
      "expect": "#drawing[data-playing] g[data-base] [data-item][transform]"
    },
    {
      "name": "laptop-slider-rest",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "fill": [
            "#spacing",
            "40"
          ]
        },
        {
          "wait": 400
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        },
        {
          "wait": 300
        }
      ],
      "expect": "#drawing:not([data-playing]) g:not([data-base])"
    },
    {
      "name": "laptop-tip-animating",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "[data-drawing=tip]"
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        },
        {
          "click": "[data-view=assembled]"
        },
        {
          "wait": 250
        }
      ],
      "expect": "#drawing[data-playing] g[data-base]"
    },
    {
      "name": "phone-tip-animating",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-drawing=tip]"
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        },
        {
          "click": "[data-view=assembled]"
        },
        {
          "wait": 250
        }
      ],
      "expect": "#drawing[data-playing] g[data-base]"
    },
    {
      "name": "laptop-tip",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "[data-drawing=tip]"
        },
        {
          "wait": 800
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        }
      ],
      "expect": "svg[aria-label^=\"Distal tip\"]"
    },
    {
      "name": "laptop-no-labels",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "#labels"
        },
        {
          "wait": 800
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        }
      ],
      "expect": "#labels[aria-pressed=false]"
    },
    {
      "name": "laptop-parts-tab",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "#tab-parts"
        }
      ],
      "expect": "#panel-parts:not([hidden])"
    },
    {
      "name": "laptop-dark",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "colorScheme": "dark",
      "actions": [
        {
          "wait": 300
        }
      ],
      "expect": "#drawing svg"
    },
    {
      "name": "phone-zoom",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-zoom=\"1\"]"
        },
        {
          "click": "[data-zoom=\"1\"]"
        },
        {
          "wait": 300
        }
      ],
      "expect": "#viewport[data-zoomed]"
    },
    {
      "name": "phone-details",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-pane=details]"
        },
        {
          "click": "#tab-spec"
        }
      ],
      "expect": "#pane-details:visible"
    },
    {
      "name": "phone-tip-assembled",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-drawing=tip]"
        },
        {
          "wait": 3000
        },
        {
          "click": "[data-view=assembled]"
        },
        {
          "wait": 1500
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        }
      ],
      "expect": "svg[aria-label$=\"assembled view\"]"
    },
    {
      "name": "phone-open-details-then-drawing",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "hash": "#details",
      "actions": [
        {
          "wait": 1500
        },
        {
          "click": "[data-pane=drawing]"
        },
        {
          "ready": "#viewport[aria-busy=\"false\"]"
        },
        {
          "wait": 500
        }
      ],
      "expect": "#drawing svg:not([viewBox=\"0 0 420 297\"]):not([viewBox^=\"-3.00 -3.00 6.00\"])"
    },
    {
      "name": "laptop-tab-keys",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "#tab-overview"
        },
        {
          "key": "End"
        }
      ],
      "expect": "#tab-sources[aria-selected=true][tabindex=\"0\"]"
    },
    {
      "name": "laptop-proto-tab",
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "actions": [
        {
          "click": "#tab-proto"
        }
      ],
      "expect": "#panel-proto:not([hidden]) table"
    },
    {
      "name": "phone-proto-tab",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "actions": [
        {
          "click": "[data-pane=details]"
        },
        {
          "click": "#tab-proto"
        }
      ],
      "expect": "#panel-proto:not([hidden]) table"
    }
  ]
}
